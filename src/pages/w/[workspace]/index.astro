---
// src/pages/w/[workspace]/index.astro
import MainLayout from "../../../layouts/MainLayout.astro";
import DashboardProduccion from "../../../components/DashboardProduccion.astro";
import DashboardEscolar from "../../../components/DashboardEscolar.astro";
import { getTrabajosWorkspace } from "../../../lib/db-utils";

const { workspace } = Astro.params;

if (!workspace) return Astro.redirect("/w/produccion");
if (workspace === "facturacion") return Astro.redirect("/w/facturacion/facturacion");
const trabajosProximos = await getTrabajosWorkspace(workspace);
---

<MainLayout title={`Panel de Control — ${workspace.toUpperCase()}`}>
  {
    workspace === "produccion" && (
      <DashboardProduccion
        trabajosProximos={trabajosProximos}
        workspace={workspace}
      />
    )
  }

  {
    workspace === "escolar" && (
      <DashboardEscolar
        trabajosProximos={trabajosProximos}
        workspace={workspace}
      />
    )
  }

  {
    workspace === "profesional" && (
      <div class="p-8 text-center text-gray-400">
        Panel Profesional en desarrollo...
      </div>
    )
  }
</MainLayout>

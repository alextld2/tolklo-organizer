---
// src/layouts/MainLayout.astro

// 1. IMPORTACIONES DE ESTILOS Y COMPONENTES MARCO
import "../styles/global.css";
import Sidebar from "../components/Sidebar.astro";
import Header from "../components/Header.svelte"; // Tu buscador inteligente
import { ClientRouter } from "astro:transitions";

import SidebarWrapper from "../components/SidebarWrapper.svelte";

interface Props {
  title: string;
}
const { title } = Astro.props;

// 🛠️ DETECTOR DE ENTORNO PARA EL DOCK INFERIOR RESPONSIVE
const currentPath = Astro.url.pathname;
const workspace = currentPath.split("/")[2] || "produccion";
const alternarWorkspace = workspace === "produccion" ? "escolar" : "produccion";
const urlAlternativa = currentPath.replace(
  `/w/${workspace}`,
  `/w/${alternarWorkspace}`,
);

const enlacesNav = workspace === "facturacion"
  ? [
      { nombre: "Presupuestos", ruta: `/w/facturacion/presupuestos`, icono: "presupuestos" },
      { nombre: "Albaranes", ruta: `/w/facturacion/albaranes`, icono: "albaranes" },
      { nombre: "Facturación", ruta: `/w/facturacion/facturacion`, icono: "facturacion" },
    ]
  : [
      { nombre: "Inicio", ruta: `/w/${workspace}`, icono: "home" },
      { nombre: "Tareas", ruta: `/w/${workspace}/tasks`, icono: "assignment" },
      {
        nombre: "Calendario",
        ruta: `/w/${workspace}/calendar`,
        icono: "calendar_today",
      },
      { nombre: "Clientes", ruta: `/w/${workspace}/clients`, icono: "badge" },
    ];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon-app.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <ClientRouter />

    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
    />

    <script is:inline>
      const aplicarTema = () => {
        const theme = localStorage.getItem("theme");
        if (
          theme === "dark" ||
          (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches)
        ) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      };
      aplicarTema();
      document.addEventListener("astro:after-swap", aplicarTema);
    </script>
  </head>

  <body
    class="bg-background text-foreground transition-colors duration-200 min-h-screen overflow-hidden font-sans p-2 sm:p-2.5 lg:p-3"
  >
    <div class="flex h-[calc(100vh-1rem)] sm:h-[calc(100vh-1.25rem)] w-full overflow-hidden">
      <!-- 🔄 Sidebar con contenedor reactivo colapsable -->
      <SidebarWrapper client:load>
        <Sidebar />
      </SidebarWrapper>

      <!-- 🖼️ MARCO PRINCIPAL INSET (Fondo blanco, esquinas redondeadas, borde fino) -->
      <div class="flex-1 flex flex-col min-w-0 h-full bg-card border border-border/70 rounded-2xl md:rounded-3xl shadow-2xs overflow-hidden transition-all duration-300">
        <!-- 🔍 Header inteligente con Toggle de Sidebar, Breadcrumbs y Buscador -->
        <Header client:load transition:persist="header" />

        <main
          class="flex-1 overflow-y-auto px-4 sm:px-6 lg:px-8 pb-28 lg:pb-8 min-h-0"
        >
          <slot />
        </main>
      </div>
    </div>

    <!-- 📱 Menú móvil adaptado a shadcn tokens -->
    <div
      class="fixed bottom-6 inset-x-0 z-[250] flex justify-center pointer-events-none lg:hidden"
    >
      <nav
        class="bg-card/90 backdrop-blur-xl border border-border rounded-2xl px-2 py-2.5 shadow-xl flex items-center justify-around w-[94%] max-w-md pointer-events-auto animate-slide-up"
      >
        <!-- Workspace switcher button -->
        <a
          href={urlAlternativa}
          class="flex flex-col items-center justify-center flex-1 py-1 px-0.5 text-muted-foreground hover:text-primary transition-all relative"
          title={`Cambiar a espacio ${alternarWorkspace}`}
        >
          {workspace === "produccion" ? (
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>
            </svg>
          ) : (
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/>
              <path d="M17 18h1"/><path d="M12 18h1"/><path d="M7 18h1"/>
            </svg>
          )}
          <span class="text-[9px] font-semibold uppercase tracking-tighter mt-0.5">
            {workspace === "produccion" ? "Escolar" : "Taller"}
          </span>
          <span class="absolute top-0.5 right-4 w-1.5 h-1.5 bg-primary rounded-full animate-pulse"></span>
        </a>

        <div class="w-px h-6 bg-border mx-0.5 flex-shrink-0"></div>

        {
          enlacesNav.map((item) => {
            const esActivo = currentPath === item.ruta || currentPath.startsWith(item.ruta + "/");
            // Inline SVG per icon name
            const iconSVGs: Record<string, string> = {
              home: `<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>`,
              assignment: `<rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-4"/>`,
              calendar_today: `<rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M16 18h.01"/>`,
              badge: `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
              presupuestos: `<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M8 13h2"/><path d="M14 13h2"/><path d="M8 17h2"/><path d="M14 17h2"/>`,
              albaranes: `<path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-5l-3-4h-5v10Z"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/>`,
              facturacion: `<path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><path d="M14 8H8"/><path d="M16 12H8"/><path d="M13 16H8"/>`,
            };
            return (
              <a
                href={item.ruta}
                class={`flex flex-col items-center justify-center flex-1 py-1 px-0.5 rounded-xl transition-all ${esActivo ? "text-primary font-semibold" : "text-muted-foreground hover:text-foreground"}`}
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={esActivo ? "2.5" : "2"} stroke-linecap="round" stroke-linejoin="round" set:html={iconSVGs[item.icono] || ""} />
                <span class="text-[9px] font-semibold tracking-tight mt-0.5 max-w-full truncate">
                  {item.nombre}
                </span>
              </a>
            );
          })
        }

        <div class="w-px h-6 bg-border mx-0.5 flex-shrink-0"></div>

        <a
          href="/login"
          class="w-9 h-9 rounded-xl bg-muted text-muted-foreground hover:text-destructive flex items-center justify-center transition-colors flex-shrink-0"
        >
          <!-- LogOut (Lucide) -->
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
            <polyline points="16 17 21 12 16 7"/>
            <line x1="21" x2="9" y1="12" y2="12"/>
          </svg>
        </a>
      </nav>
    </div>
  </body>
</html>

<style>
  @keyframes slide-up {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-slide-up {
    animation: slide-up 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>

---
// src/components/DashboardProduccion.astro
import OrdenesActivas from "./OrdenesActivas.svelte";
import ChartBarLabel from "./ui/chart/chart-bar-label.svelte";

const { trabajosProximos, workspace } = Astro.props;

// Captura del usuario desde el middleware
const user = Astro.locals.user;

// 🕒 DETECTOR HORARIO DINÁMICO
const hora = new Date().getHours();
let saludo = "Buenas noches";

if (hora >= 6 && hora < 14) {
  saludo = "Buenos días";
} else if (hora >= 14 && hora < 21) {
  saludo = "Buenas tardes";
}

// ==========================================
// 🧠 MÉTRICAS Y ESTADOS DINÁMICOS EN BASE A LA NUEVA TAXONOMÍA
// ==========================================
const totales = trabajosProximos.length;
const terminados = trabajosProximos.filter(
  (t) => t.estado === "Terminado",
).length;

// Cola activa: Órdenes que están físicamente procesándose en la planta de producción
const estadosActivos = ["Imprimiendo", "Manipulado", "Urgente"];
const enColaActiva = trabajosProximos.filter((t) =>
  estadosActivos.includes(t.estado),
).length;

// Progreso porcentual real sin bugs de división por cero o bloqueos estáticos
const porcentajeProgreso =
  totales > 0 ? Math.round((terminados / totales) * 100) : 0;

// ==========================================
// 📊 PROCESAMIENTO DEL GRÁFICO MENSUAL
// ==========================================
const volumenMensualActual = Array(12).fill(0);

const mesesNombresLargos = [
  "Enero",
  "Febrero",
  "Marzo",
  "Abril",
  "Mayo",
  "Junio",
  "Julio",
  "Agosto",
  "Septiembre",
  "Octubre",
  "Noviembre",
  "Diciembre",
];

trabajosProximos.forEach((t) => {
  if (!t.fechaSalida) return;
  const str = String(t.fechaSalida).trim();
  let mesIndex = -1;

  if (str.includes("-")) {
    const parts = str.split("-");
    mesIndex =
      parts[0].length === 4
        ? parseInt(parts[1], 10) - 1 // YYYY-MM-DD
        : parseInt(parts[1], 10) - 1; // DD-MM-YYYY
  } else if (str.includes("/")) {
    const parts = str.split("/");
    mesIndex =
      parts[0].length === 4
        ? parseInt(parts[1], 10) - 1
        : parseInt(parts[1], 10) - 1;
  } else {
    const d = new Date(str);
    if (!isNaN(d.getTime())) mesIndex = d.getMonth();
  }

  if (mesIndex >= 0 && mesIndex < 12) volumenMensualActual[mesIndex]++;
});

const partesAñoActual = volumenMensualActual.reduce((a, b) => a + b, 0);

// Mes récord
let mejorMesIdx = 0;
let maxMesVolumen = 0;
volumenMensualActual.forEach((v, idx) => {
  if (v > maxMesVolumen) {
    maxMesVolumen = v;
    mejorMesIdx = idx;
  }
});
const nombreMejorMes =
  maxMesVolumen > 0 ? mesesNombresLargos[mejorMesIdx] : "Sin registros";
const puntosMejorMes = maxMesVolumen;

// Filtrado actividad máquinas
const maquinasEnActividad = trabajosProximos.filter((t) =>
  estadosActivos.includes(t.estado),
);

const meses = [
  "Ene",
  "Feb",
  "Mar",
  "Abr",
  "May",
  "Jun",
  "Jul",
  "Ago",
  "Sep",
  "Oct",
  "Nov",
  "Dic",
];
---

<div class="space-y-6 w-full animate-fade-in font-sans text-foreground">
  <div class="mb-5">
    <h1 class="text-3xl font-semibold tracking-tight text-foreground">
      {saludo}, {user ? user.name : "compañero"}.
    </h1>
    <p class="text-xs font-medium text-muted-foreground mt-1">
      Indica el flujo operativo de producción actual y los marcadores generales.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-4 gap-5">
    <div
      class="bg-card text-card-foreground border border-border rounded-3xl p-5 flex items-center justify-between transition-colors shadow-xs"
    >
      <div class="space-y-1">
        <span
          class="text-[9px] font-semibold text-muted-foreground uppercase tracking-widest block"
          >Progreso de Año</span
        >
        <h3 class="text-2xl font-semibold text-foreground">
          {porcentajeProgreso}%
        </h3>
      </div>

      <div
        class="relative w-12 h-12 flex items-center justify-center flex-shrink-0"
      >
        <svg class="w-full h-full transform -rotate-90" viewBox="0 0 36 36">
          <path
            class="text-muted"
            stroke-width="3"
            stroke="currentColor"
            fill="none"
            d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
          ></path>
          <path
            class="text-primary"
            stroke-dasharray={`${porcentajeProgreso}, 100`}
            stroke-width="3"
            stroke-linecap="round"
            stroke="currentColor"
            fill="none"
            d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
          ></path>
        </svg>
      </div>
    </div>

    <div
      class="bg-primary text-primary-foreground rounded-3xl p-5 flex justify-between items-center md:col-span-2 overflow-hidden relative shadow-md"
    >
      <div>
        <span
          class="text-[9px] font-semibold uppercase tracking-widest text-primary-foreground/70 block leading-none"
          >Partes Totales</span
        >
        <h3 class="text-4xl font-semibold mt-2">
          {totales.toString().padStart(2, "0")}
        </h3>
      </div>
      <div
        class="text-right border-l border-primary-foreground/20 pl-6 h-10 flex flex-col justify-center"
      >
        <span
          class="text-[9px] font-semibold uppercase tracking-widest text-primary-foreground/70 block leading-none"
          >Mejor Mes</span
        >
        <span class="text-xs font-semibold mt-1 capitalize"
          >{nombreMejorMes}
          <span class="opacity-80 font-normal">({puntosMejorMes} Partes)</span
          ></span
        >
      </div>
    </div>

    <div
      class="bg-card text-card-foreground border border-border rounded-3xl p-5 flex items-center justify-between transition-colors shadow-xs"
    >
      <div class="space-y-0.5">
        <span
          class="text-[9px] font-semibold text-muted-foreground uppercase tracking-widest block leading-none"
          >En cola activa</span
        >
        <h3 class="text-2xl font-semibold text-foreground mt-1">
          {enColaActiva.toString().padStart(2, "0")}
        </h3>
      </div>
      <div
        class="w-9 h-9 rounded-xl bg-muted text-foreground flex items-center justify-center flex-shrink-0"
      >
        <span
          class="material-symbols-rounded text-lg"
          style="font-variation-settings: 'wght' 300, 'opsz' 100;"
          >multiple_stop</span
        >
      </div>
    </div>
  </div>

  <ChartBarLabel
    datos={volumenMensualActual}
    meses={meses}
    totales={partesAñoActual}
    client:load
  />

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2">
      <OrdenesActivas
        trabajosProximos={trabajosProximos}
        workspace={workspace}
        client:load
      />
    </div>

    <div
      class="bg-card text-card-foreground border border-border rounded-3xl p-6 flex flex-col transition-colors shadow-xs"
    >
      <div class="mb-4">
        <h3 class="text-sm font-semibold text-foreground tracking-tight">
          Actividad de Máquinas
        </h3>
        <p class="text-[11px] text-muted-foreground mt-0.5">
          Monitoreo en tiempo real de los lotes activos en el taller.
        </p>
      </div>

      <div
        class="space-y-3 flex-1 overflow-y-auto text-xs font-semibold max-h-[320px] pr-1"
      >
        {
          maquinasEnActividad.length > 0 ? (
            maquinasEnActividad.map((t) => (
              <div
                class="p-3 bg-muted/50 border border-border rounded-xl flex items-center justify-between gap-3 animate-fade-in"
                key={t.numParte}
              >
                <div class="flex flex-col min-w-0">
                  <span class="text-foreground truncate font-semibold">
                    Lote #{t.numParte} — Área {t.area}
                  </span>
                  <span class="text-[10px] text-muted-foreground font-medium mt-0.5 truncate uppercase">
                    {t.cliente} // {t.descripcionGeneral || "Sin desglose"}
                  </span>
                </div>
                <span
                  class={`px-2 py-0.5 text-[9px] rounded font-semibold uppercase flex-shrink-0 tracking-wider border
                ${t.estado === "Urgente" ? "bg-destructive/10 text-destructive border-destructive/20 animate-pulse" : ""}
                ${t.estado === "Imprimiendo" ? "bg-blue-500/10 text-blue-600 border-blue-500/20" : ""}
                ${t.estado === "Manipulado" ? "bg-amber-500/10 text-amber-600 border-amber-500/20" : ""}
              `}
                >
                  {t.estado === "Imprimiendo" ? "En curso" : t.estado}
                </span>
              </div>
            ))
          ) : (
            <div class="h-full flex flex-col items-center justify-center text-center py-10 text-muted-foreground space-y-2">
              <span class="material-symbols-rounded text-2xl opacity-40 animate-pulse">
                precision_manufacturing
              </span>
              <p class="text-[11px] font-medium max-w-[200px] leading-normal">
                Todas las líneas de ploteado y manipulado están despejadas.
              </p>
            </div>
          )
        }
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes scale-up {
    from {
      opacity: 0;
      transform: scaleY(0);
      transform-origin: bottom;
    }
    to {
      opacity: 1;
      transform: scaleY(1);
      transform-origin: bottom;
    }
  }
  .animate-scale-up {
    animation: scale-up 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>

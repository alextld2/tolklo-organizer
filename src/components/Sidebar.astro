---
// src/components/Sidebar.astro
import WorkspaceSwitcher from "./WorkspaceSwitcher.svelte";
import ThemeSelector from "./ThemeSelector.svelte";

const { workspace = "produccion" } = Astro.params;
const pathname = Astro.url.pathname;

const isPathActive = (targetPath: string, strict = false) => {
  return strict
    ? pathname === targetPath
    : pathname === targetPath || pathname.startsWith(targetPath + "/");
};

const getLinkClass = (targetPath: string, strict = false) => {
  const base = "flex items-center gap-3 px-3 py-2.5 text-xs font-medium rounded-xl transition-all group outline-none select-none";
  return isPathActive(targetPath, strict)
    ? `${base} text-primary-foreground bg-primary font-semibold shadow-xs`
    : `${base} text-muted-foreground hover:text-foreground hover:bg-accent`;
};

const isActive = (p: string, strict = false) => isPathActive(p, strict);
---

<aside class="w-64 h-full flex flex-col justify-between flex-shrink-0 font-sans py-2 pr-2">
  <div class="flex flex-col space-y-4">
    <div class="h-20 flex items-center px-6 border-b border-border flex-shrink-0">
      <a href={workspace === "facturacion" ? "/w/facturacion/facturacion" : `/w/${workspace}`} class="flex items-center gap-2 group outline-none">
        <img
          src="/logotipo-app.svg"
          alt="Tolkie Organizer"
          class="h-8 w-auto object-contain transition-transform group-hover:scale-[1.01] dark:invert"
        />
      </a>
    </div>

    <WorkspaceSwitcher workspaceActivo={workspace} client:load />

    <nav class="flex flex-col px-4 pt-2 space-y-1">
      {workspace === "facturacion" ? (
        <>
          <div class="pt-1 pb-1 px-3">
            <span class="text-[9px] font-bold text-muted-foreground/70 uppercase tracking-widest">Documentos</span>
          </div>

          <a href={`/w/${workspace}/presupuestos`} class={getLinkClass(`/w/${workspace}/presupuestos`)}>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              class={isActive(`/w/${workspace}/presupuestos`) ? "opacity-100" : "opacity-70"}>
              <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/>
              <path d="M14 2v4a2 2 0 0 0 2 2h4"/>
              <path d="M8 13h2"/>
              <path d="M14 13h2"/>
              <path d="M8 17h2"/>
              <path d="M14 17h2"/>
            </svg>
            <span>Presupuestos</span>
          </a>

          <!-- Escandallo e Imposición Técnica -->
          <a href={`/w/${workspace}/escandallo`} class={getLinkClass(`/w/${workspace}/escandallo`)}>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              class={isActive(`/w/${workspace}/escandallo`) ? "opacity-100" : "opacity-70"}>
              <rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/>
            </svg>
            <div class="flex items-center justify-between flex-1">
              <span>Escandallo & Poses</span>
              <span class="text-[8px] px-1.5 py-0.2 rounded-md bg-amber-500/15 text-amber-600 dark:text-amber-400 font-bold tracking-tight">MIS</span>
            </div>
          </a>

          <a href={`/w/${workspace}/albaranes`} class={getLinkClass(`/w/${workspace}/albaranes`)}>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              class={isActive(`/w/${workspace}/albaranes`) ? "opacity-100" : "opacity-70"}>
              <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/>
              <path d="M15 18H9"/>
              <path d="M19 18h2a1 1 0 0 0 1-1v-5l-3-4h-5v10Z"/>
              <circle cx="7" cy="18" r="2"/>
              <circle cx="17" cy="18" r="2"/>
            </svg>
            <span>Albaranes</span>
          </a>

          <a href={`/w/${workspace}/facturacion`} class={getLinkClass(`/w/${workspace}/facturacion`)}>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              class={isActive(`/w/${workspace}/facturacion`) ? "opacity-100" : "opacity-70"}>
              <path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/>
              <path d="M14 8H8"/>
              <path d="M16 12H8"/>
              <path d="M13 16H8"/>
            </svg>
            <div class="flex items-center justify-between flex-1">
              <span>Facturación</span>
              <span class="text-[8px] px-1.5 py-0.2 rounded-md bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 font-bold tracking-tight">VERI*FACTU</span>
            </div>
          </a>
        </>
      ) : (
        <>
          <a href={`/w/${workspace}`} class={getLinkClass(`/w/${workspace}`, true)}>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              class={isActive(`/w/${workspace}`, true) ? "opacity-100" : "opacity-70"}>
              <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
            <span>Inicio</span>
          </a>

          <a href={`/w/${workspace}/tasks`} class={getLinkClass(`/w/${workspace}/tasks`)}>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              class={isActive(`/w/${workspace}/tasks`) ? "opacity-100" : "opacity-70"}>
              <rect width="8" height="4" x="8" y="2" rx="1" ry="1"/>
              <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
              <path d="m9 14 2 2 4-4"/>
            </svg>
            <span>Tareas</span>
          </a>

          <a href={`/w/${workspace}/cola`} class={getLinkClass(`/w/${workspace}/cola`)}>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              class={isActive(`/w/${workspace}/cola`) ? "opacity-100" : "opacity-70"}>
              <line x1="10" x2="21" y1="6" y2="6"/>
              <line x1="10" x2="21" y1="12" y2="12"/>
              <line x1="10" x2="21" y1="18" y2="18"/>
              <path d="M4 6h1v4"/>
              <path d="M4 10h2"/>
              <path d="M6 18H4c0-1 2-2 2-3s-1-1.5-2-1"/>
            </svg>
            <div class="flex items-center justify-between flex-1">
              <span>Cola Taller</span>
              <span class="text-[9px] px-1.5 py-0.2 rounded-md bg-amber-500/20 text-amber-600 dark:text-amber-400 font-bold uppercase tracking-wider">TV</span>
            </div>
          </a>

          <a href={`/w/${workspace}/calendar`} class={getLinkClass(`/w/${workspace}/calendar`)}>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              class={isActive(`/w/${workspace}/calendar`) ? "opacity-100" : "opacity-70"}>
              <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
              <line x1="16" x2="16" y1="2" y2="6"/>
              <line x1="8" x2="8" y1="2" y2="6"/>
              <line x1="3" x2="21" y1="10" y2="10"/>
              <path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/>
              <path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M16 18h.01"/>
            </svg>
            <span>Calendario</span>
          </a>

          <a href={`/w/${workspace}/clients`} class={getLinkClass(`/w/${workspace}/clients`)}>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              class={isActive(`/w/${workspace}/clients`) ? "opacity-100" : "opacity-70"}>
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            <span>Clientes</span>
          </a>
        </>
      )}
    </nav>
  </div>

  <div class="p-4 space-y-4 flex flex-col">
    {workspace !== "facturacion" && (
      <a
        href={`/w/${workspace}/nueva-tarea`}
        class="w-full bg-primary text-primary-foreground font-semibold text-xs py-3 rounded-xl hover:bg-primary/90 transition-all shadow-xs flex items-center justify-center gap-2 outline-none text-center select-none"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
        <span>Registrar nuevo parte</span>
      </a>
    )}

    <div class="border-t border-border pt-3 space-y-0.5">
      <ThemeSelector client:load />

      {workspace !== "facturacion" && (
        <a
          href={`/w/${workspace}/logs`}
          class="flex items-center gap-3 px-3 py-2 rounded-xl text-xs font-medium text-muted-foreground hover:text-foreground hover:bg-accent transition-all outline-none"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/>
            <path d="M12 8v4"/><path d="M12 16h.01"/>
          </svg>
          <span>Registro/Logs</span>
        </a>
      )}

      <a
        href="/api/auth/logout"
        data-astro-reload
        class="flex items-center gap-2 px-3 py-2 text-xs font-medium text-muted-foreground hover:text-destructive transition-colors cursor-pointer rounded-xl hover:bg-destructive/10"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
          <polyline points="16 17 21 12 16 7"/>
          <line x1="21" x2="9" y1="12" y2="12"/>
        </svg>
        <span>Cerrar sesión</span>
      </a>
    </div>
  </div>
</aside>
